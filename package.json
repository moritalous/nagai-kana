{
	"name": "nagai-kana-cli",
	"version": "0.1.0",
	"description": "入るかな CLI — Markdownドキュメントのページ数を計測するCLIツール",
	"type": "module",
	"module": "./src/index.ts",
	"types": "./src/index.ts",
	"bin": {
		"nagai-kana-cli": "./src/cli.ts"
	},
	"exports": {
		".": {
			"import": "./src/index.ts",
			"types": "./src/index.ts"
		}
	},
	"scripts": {
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"test": "bun test",
		"check": "biome check --write . && bun test"
	},
	"dependencies": {
		"github-markdown-css": "^5.8.1"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"fast-check": "^3.0.0"
	}
}
